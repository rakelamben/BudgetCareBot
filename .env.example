# ==============================================================================
# BUDGET CARE - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env dan isi nilai yang sesuai
# ==============================================================================

# 1. KREDENSIAL TELEGRAM BOT
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# String acak aman untuk validasi header webhook Telegram (bebas dibuat sendiri)
TELEGRAM_WEBHOOK_SECRET="bc_sec_webhook_secret_key_12345"

# 2. INTERNAL TICK SECRET (CRON)
# String acak aman untuk autentikasi pg_cron -> POST /internal/tick
TICK_SECRET="bc_sec_tick_secret_key_67890"

# 3. KONEKSI SUPABASE POSTGRESQL
# A. DATABASE_URL: Transaction Pooler (Port 6543)
# Digunakan oleh aplikasi FastAPI & Bot saat runtime.
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# B. DATABASE_URL_MIGRATIONS: Session Pooler / Direct Connection (Port 5432)
# Digunakan khusus oleh Alembic untuk mengeksekusi DDL / pembuatan tabel.
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL_MIGRATIONS="postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 4. SUPABASE STORAGE (PUBLIC BUCKET)
# URL publik ke bucket 'pets' di Supabase Storage
# Format: https://[PROJECT-REF].supabase.co/storage/v1/object/public/pets
PET_IMAGE_BASE_URL="https://yourprojectref.supabase.co/storage/v1/object/public/pets"

# 5. ENVIRONMENT & LOGGING
APP_ENV="local"
LOG_LEVEL="INFO"

# 6. TUNING & RATE LIMITS (DEFAULT)
CUTOFF_GRACE_SECONDS=60
TICK_TIME_BUDGET_SECONDS=25
TICK_LEASE_SECONDS=120
SEND_RATE_PER_SECOND=25
SEND_BATCH_SIZE=200
MAX_NOTIFICATION_ATTEMPTS=3
STALE_CLAIM_MINUTES=5
STALE_NOTIFICATION_HOURS=3
UNDO_WINDOW_HOURS=24
